# M00 requires no credentials. These values configure local, non-billable services.
FPG_ENV=development
FPG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
FPG_MODEL_ALIASES_PATH=machine-readable/model-aliases.example.json
FPG_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FPG_API_URL=http://127.0.0.1:8000
FPG_REPOSITORY_ROOT=/absolute/path/to/film-production-graph
FPG_SKILL_ROOTS=skills
FPG_SKILLS_LOCK=skills.lock

# Protected M04a execution only. Leave empty until a provider is selected and
# never commit a real value. Ordinary tests and dry-run planning do not read it.
M04A_PROVIDER_SECRET=
