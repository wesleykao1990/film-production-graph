{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subtext Pass Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_contract_version_id",
    "screenplay_scene_version_id",
    "allowed_paths"
  ],
  "properties": {
    "scene_contract_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "screenplay_scene_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "character_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "relationship_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "review_notes": {
      "type": "string"
    }
  }
}
