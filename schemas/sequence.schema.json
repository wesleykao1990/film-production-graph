{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-production-graph:schema:sequence:1",
  "title": "Sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence_id",
    "title",
    "scene_ids",
    "dramatic_function",
    "start_state_ref",
    "end_state_ref"
  ],
  "properties": {
    "sequence_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scene_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dramatic_function": {
      "type": "string",
      "minLength": 1
    },
    "start_state_ref": {
      "type": "string"
    },
    "end_state_ref": {
      "type": "string"
    },
    "music_cue_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "visual_strategy": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
