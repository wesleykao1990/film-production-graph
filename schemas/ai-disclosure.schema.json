{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-production-graph:schema:ai-disclosure:1",
  "title": "Human-Readable AI Use Disclosure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disclosure_id",
    "languages",
    "summary",
    "channels"
  ],
  "properties": {
    "disclosure_id": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "items": {
        "enum": [
          "end_credits",
          "description",
          "festival_submission",
          "website",
          "sidecar"
        ]
      },
      "uniqueItems": true
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
