{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-production-graph:schema:skills-lock:1",
  "title": "Skills Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "skills"
  ],
  "properties": {
    "lock_version": {
      "const": 1
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "source_commit",
          "content_hash",
          "metadata_version"
        ],
        "properties": {
          "source_path": {
            "type": "string"
          },
          "source_commit": {
            "type": "string",
            "minLength": 7
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "metadata_version": {
            "type": "string"
          }
        }
      }
    }
  }
}
