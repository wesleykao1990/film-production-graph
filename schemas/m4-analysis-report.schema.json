{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-production-graph:schema:m4-analysis-report:4",
  "title": "M04 Story Room Analysis Report v2.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_version",
    "decision_mode",
    "run_mode",
    "evidence_strength",
    "decision",
    "rater_count",
    "rater_workload",
    "instrument_check",
    "reliability_diagnostics",
    "preference_results_withheld",
    "preferences",
    "primary_requirements",
    "mixed_repeat_plan",
    "continuity",
    "cost_latency",
    "warnings"
  ],
  "properties": {
    "analysis_version": {
      "type": "string"
    },
    "decision_mode": {
      "const": "exploratory_product_heuristic"
    },
    "run_mode": {
      "enum": [
        "standard_seven",
        "standard_six",
        "standard_five",
        "degraded_three"
      ]
    },
    "evidence_strength": {
      "enum": [
        "standard",
        "degraded_rater_diversity"
      ]
    },
    "decision": {
      "enum": [
        "PASS",
        "MIXED",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "rater_count": {
      "type": "integer",
      "minimum": 1
    },
    "rater_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triplets_by_rater",
        "anchor_tasks_by_rater",
        "minutes_by_rater"
      ],
      "properties": {
        "triplets_by_rater": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "anchor_tasks_by_rater": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "minutes_by_rater": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "instrument_check": {
      "$ref": "#/$defs/instrumentCheck"
    },
    "reliability_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specificity",
        "character_voice",
        "causal_progression"
      ],
      "properties": {
        "specificity": {
          "$ref": "#/$defs/reliabilityDiagnostic"
        },
        "character_voice": {
          "$ref": "#/$defs/reliabilityDiagnostic"
        },
        "causal_progression": {
          "$ref": "#/$defs/reliabilityDiagnostic"
        }
      }
    },
    "preference_results_withheld": {
      "type": "boolean"
    },
    "preferences": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "specificity",
            "character_voice",
            "causal_progression"
          ],
          "properties": {
            "specificity": {
              "$ref": "#/$defs/preferenceResult"
            },
            "character_voice": {
              "$ref": "#/$defs/preferenceResult"
            },
            "causal_progression": {
              "$ref": "#/$defs/preferenceResult"
            }
          }
        }
      ]
    },
    "primary_requirements": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "specificity",
            "character_voice",
            "causal_progression"
          ],
          "properties": {
            "specificity": {
              "type": "boolean"
            },
            "character_voice": {
              "type": "boolean"
            },
            "causal_progression": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "mixed_repeat_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "affected_dimensions",
        "previously_passing_dimensions",
        "runs_per_condition",
        "threshold_policy",
        "round_one_pooling",
        "instrument_policy"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "affected_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "specificity",
              "character_voice",
              "causal_progression"
            ]
          }
        },
        "previously_passing_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "specificity",
              "character_voice",
              "causal_progression"
            ]
          }
        },
        "runs_per_condition": {
          "type": "integer",
          "minimum": 3
        },
        "threshold_policy": {
          "const": "same_as_primary_aggregate"
        },
        "round_one_pooling": {
          "const": "report_separately_do_not_pool"
        },
        "instrument_policy": {
          "const": "inherit_if_same_rater_pool_else_repeat_anchors"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mean_hard_violations_by_condition",
        "best_baseline_mean",
        "story_room_mean",
        "non_inferior"
      ]
    },
    "cost_latency": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "countBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intact",
        "degraded",
        "total"
      ],
      "properties": {
        "intact": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "instrumentDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "intact_preference",
        "per_dimension_intact_preference_floor",
        "comparison",
        "direction_passed",
        "passed"
      ],
      "properties": {
        "counts": {
          "$ref": "#/$defs/countBlock"
        },
        "intact_preference": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "per_dimension_intact_preference_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "comparison": {
          "const": "strictly_greater"
        },
        "direction_passed": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "instrumentCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "failure_outcome",
        "response_mode",
        "technical_issue_policy",
        "assigned_rater_count",
        "per_dimension",
        "pooled"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "failure_outcome": {
          "const": "INCONCLUSIVE"
        },
        "assigned_rater_count": {
          "type": "integer",
          "minimum": 1
        },
        "per_dimension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "specificity",
            "character_voice",
            "causal_progression"
          ],
          "properties": {
            "specificity": {
              "$ref": "#/$defs/instrumentDimension"
            },
            "character_voice": {
              "$ref": "#/$defs/instrumentDimension"
            },
            "causal_progression": {
              "$ref": "#/$defs/instrumentDimension"
            }
          }
        },
        "pooled": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counts",
            "intact_preference",
            "minimum_intact_preference",
            "passed"
          ],
          "properties": {
            "counts": {
              "$ref": "#/$defs/countBlock"
            },
            "intact_preference": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minimum_intact_preference": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "passed": {
              "type": "boolean"
            }
          }
        },
        "response_mode": {
          "const": "forced_choice"
        },
        "technical_issue_policy": {
          "const": "abort_replace_not_score"
        }
      }
    },
    "reliabilityDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_pairwise_agreement",
        "krippendorff_alpha_nominal",
        "tie_rate",
        "gating"
      ],
      "properties": {
        "raw_pairwise_agreement": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "krippendorff_alpha_nominal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "tie_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "gating": {
          "const": false
        }
      }
    },
    "preferenceResult": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "against_equal_information",
        "against_fixed_budget_conventional",
        "stronger_baseline",
        "stronger_baseline_preference",
        "aggregate_against_both_passed",
        "per_brief_baseline_policy",
        "briefs_clearing_threshold",
        "briefs_required",
        "requirement_passed",
        "per_brief_preference_floor",
        "per_brief_comparison"
      ]
    }
  }
}
