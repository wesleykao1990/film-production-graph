{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-production-graph:schema:workflow-plan:2",
  "title": "Workflow Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "name",
    "version",
    "inputs",
    "outputs",
    "steps"
  ],
  "properties": {
    "api_version": {
      "const": "film.workflow/v2"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "type": {
            "enum": [
              "agent_run",
              "validator",
              "transform",
              "human_approval",
              "fan_out",
              "join",
              "provider_task",
              "media_job",
              "emit_artifact"
            ]
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skill": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "validator": {
            "type": "string"
          },
          "input_map": {
            "type": "object"
          },
          "output_map": {
            "type": "object"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "reject_route": {
            "type": "string"
          },
          "max_revisions": {
            "type": "integer",
            "minimum": 0
          },
          "human_policy": {
            "type": "object"
          },
          "budget": {
            "type": "object"
          }
        }
      }
    }
  }
}
