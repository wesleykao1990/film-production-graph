{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-production-graph:schema:release-manifest:1",
  "title": "Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "timeline_version_id",
    "delivery_spec_version_id",
    "master_asset_refs",
    "subtitle_track_refs",
    "rights_status",
    "delivery_validation_status",
    "provenance_sidecar_ref",
    "ai_disclosure_ref"
  ],
  "properties": {
    "release_id": {
      "type": "string"
    },
    "timeline_version_id": {
      "type": "string"
    },
    "delivery_spec_version_id": {
      "type": "string"
    },
    "master_asset_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "subtitle_track_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rights_status": {
      "const": "cleared"
    },
    "delivery_validation_status": {
      "const": "passed"
    },
    "provenance_sidecar_ref": {
      "type": "string"
    },
    "ai_disclosure_ref": {
      "type": "string"
    },
    "c2pa_status": {
      "enum": [
        "not_configured",
        "signed",
        "failed",
        "not_supported"
      ]
    },
    "released_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
